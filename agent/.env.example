# host:port of the master's gRPC endpoint
MASTER_ADDR=ci.example.com:50051

# Must match AGENT_TOKEN on the master
AGENT_TOKEN=replace-with-a-long-random-agent-token

# Unique name for this server (defaults to the hostname)
AGENT_NAME=web-prod-1

# Comma-separated labels; pipelines can target labels instead of single servers
AGENT_LABELS=production,web

# Where pipeline workspaces live (one folder per pipeline, kept between runs)
AGENT_WORKSPACE=/var/lib/cicd-agent/workspace

# Set to true if the master uses TLS; GRPC_TLS_CA only needed for a self-signed cert
# GRPC_TLS=true
# GRPC_TLS_CA=/etc/cicd/tls/ca.crt
