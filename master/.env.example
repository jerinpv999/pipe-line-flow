# HTTP API + web UI
HTTP_PORT=4000
# gRPC port that agents connect to
GRPC_PORT=50051

MONGO_URI=mongodb://localhost:27017/cicd

# Web UI login
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string

# Shared secret every agent must present when it registers
AGENT_TOKEN=replace-with-a-long-random-agent-token

# Optional TLS for gRPC (recommended when agents connect over the internet)
# GRPC_TLS_CERT=/etc/cicd/tls/server.crt
# GRPC_TLS_KEY=/etc/cicd/tls/server.key
